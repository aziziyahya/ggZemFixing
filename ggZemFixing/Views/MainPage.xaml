<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ggZemFixing.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ggZemFixing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid RowDefinitions="Auto,*">
        <!-- ── Top Navigation Bar ── -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                Padding="16,6,16,6">
            <Grid>
                <!-- Left: App Brand & Version -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Width="20" Height="20" VerticalAlignment="Center">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/AppIcon.svg" />
                        </Image.Source>
                    </Image>
                    <TextBlock Text="ggZemFixing" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="v3.0" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Right: Top Bar Menu Items -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                    <HyperlinkButton Content="How It Works" Click="OnMethodClicked"
                                     FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Padding="8,4" CornerRadius="4"/>
                    <HyperlinkButton Content="Check Ports &amp; Services" Click="OnCheckPortClicked"
                                     FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Padding="8,4" CornerRadius="4"/>
                    <HyperlinkButton Content="Support" Click="OnSupportClicked"
                                     FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Padding="8,4" CornerRadius="4"/>
                    <HyperlinkButton Content="About" Click="OnAboutClicked"
                                     FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Padding="8,4" CornerRadius="4"/>
                    
                    <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <HyperlinkButton Content="Exit" Click="OnExitClicked"
                                     FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Padding="8,4" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body: centered card ── -->
        <Grid Grid.Row="1" Margin="16,10,16,16">
            <!-- ════ CENTERED: Controls ════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel MaxWidth="540" Spacing="10">
                    
                    <!-- Main Card -->
                    <Border Style="{StaticResource Card}" Padding="24,20,24,20">
                        <StackPanel Spacing="16">
                            
                            <!-- Card Header: Title & Subtitle -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="XAMPP MySQL Recovery" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Restore corrupted MySQL tables without losing custom databases."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Path Selection Group -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="XAMPP Folder Path" FontSize="12" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMysqlRoot"
                                             Text="C:\xampp"
                                             FontFamily="Cascadia Code, Consolas"
                                             FontSize="12"
                                             PlaceholderText="C:\xampp"
                                             CornerRadius="6"
                                             VerticalAlignment="Center" />
                                    <Button x:Name="BtnBrowse" Grid.Column="1"
                                            Click="OnBrowseClicked"
                                            ToolTipService.ToolTip="Browse folder…"
                                            Padding="14,6" CornerRadius="6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xED25;" FontSize="13" />
                                            <TextBlock Text="Browse" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Verified Folder Targets (Backup & Data) -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12,8">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="BackupStatusIcon" Glyph="&#xE73E;" FontSize="11"
                                                      Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Source Template:" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="HintBackup" FontSize="11"
                                                           FontFamily="Cascadia Code, Consolas"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="DataStatusIcon" Glyph="&#xE73E;" FontSize="11"
                                                      Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Active Database:" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="HintData" FontSize="11"
                                                           FontFamily="Cascadia Code, Consolas"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Non-Destructive Safety Callout -->
                            <Border Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource AccentOrangeBrush}"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="Safe &amp; Non-Destructive:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <Run Text=" An automatic snapshot of your data folder is saved before repairs. Your databases remain intact."/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Progress & Action Section -->
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Step / Progress Detail -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Status:" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="ProgressDetailText" Text="Ready" FontSize="12"
                                                   FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <!-- Right: Percentage & Status Badge -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="RecoveryStatusBadge" Text="Ready" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentOrangeBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="RecoveryProgressBar"
                                             Minimum="0" Maximum="100" Value="0"
                                             Height="6" CornerRadius="3"
                                             Foreground="{StaticResource AccentOrangeBrush}" />

                                <Button x:Name="BtnStartRecovery"
                                        Style="{StaticResource RecoveryButton}"
                                        Click="OnStartRecoveryClicked"
                                        Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon x:Name="BtnIcon" Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock x:Name="BtnLabel" Text="Start Recovery"
                                                   FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            
                        </StackPanel>
                    </Border>

                    <!-- Footer Note -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Built by" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton Content="Azizi Yahya" Click="OnGitHubAuthorClicked"
                                         FontSize="11" Padding="2,0" MinHeight="0" MinWidth="0" VerticalAlignment="Center" />
                        <TextBlock Text="• From student to student." FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
