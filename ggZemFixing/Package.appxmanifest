<?xml version="1.0" encoding="UTF-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="f63268b7-88c9-48ee-8ef0-8c8fa69be3e3"
    Publisher="CN=AziziYahya"
    Version="3.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="f63268b7-88c9-48ee-8ef0-8c8fa69be3e3" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>ggZemFixing</DisplayName>
    <PublisherDisplayName>Azizi Yahya</PublisherDisplayName>
    <Logo>Assets\AppIcon.svg</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="ggZemFixing"
        Description="ggZemFixing is an automated recovery tool for corrupted XAMPP MySQL databases."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\AppIcon.svg"
        Square44x44Logo="Assets\AppIcon.svg">
        <uap:DefaultTile Wide310x150Logo="Assets\AppIcon.svg" />
        <uap:SplashScreen Image="Assets\AppIcon.svg" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
